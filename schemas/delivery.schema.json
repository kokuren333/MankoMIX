{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mankomix.invalid/schemas/delivery.schema.json",
  "title": "MankoMIX delivery formats",
  "description": "Validates profiles/delivery_formats.json (docs/SPEC.md section 5.3). Delivery formats describe file conditions only; dither is applied once, at the final export, only when word length is reduced (S-05).",
  "type": "object",
  "required": ["schema_version", "formats"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["draft", "provisional", "calibrated", "verified"] },
    "note": { "type": "string" },
    "formats": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/format" } }
  },
  "$defs": {
    "container": { "enum": ["wav", "flac", "aiff"] },
    "rate": { "type": "integer", "enum": [44100, 48000, 88200, 96000, 176400, 192000] },
    "format": {
      "type": "object",
      "required": ["id", "container", "sample_rate", "bit_depth", "dither"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "object", "additionalProperties": { "type": "string" } },
        "container": {
          "oneOf": [
            { "$ref": "#/$defs/container" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/container" } }
          ]
        },
        "sample_rate": {
          "oneOf": [
            { "const": "native" },
            { "$ref": "#/$defs/rate" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/rate" } }
          ]
        },
        "bit_depth": { "enum": [16, 24, "32f"] },
        "channels": { "type": "integer", "minimum": 1, "maximum": 2 },
        "dither": { "enum": ["none", "tpdf"] },
        "noise_shaping": { "const": false },
        "wav_format_tag": { "enum": ["WAVE_FORMAT_PCM", "WAVE_FORMAT_IEEE_FLOAT"] },
        "use": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "bit_depth": { "const": "32f" } } },
          "then": { "properties": { "dither": { "const": "none" } } }
        },
        {
          "if": { "properties": { "bit_depth": { "const": 16 } } },
          "then": { "properties": { "dither": { "const": "tpdf" } } }
        }
      ]
    }
  }
}
