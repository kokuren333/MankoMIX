        { "metric": "P-03", "variant": "psr", "weight": 0.20, "sense": "keep_in_range" },
        { "metric": "P-02", "variant": "temporal", "weight": 0.20, "sense": "minimize" },
        { "metric": "P-04", "variant": "kick_band", "weight": 0.20, "sense": "preserve" },
