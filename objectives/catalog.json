      "summary": { "ja": "偏りがなく、疲れにくく、要素が聞き分けられる" },
      "terms": [
        { "metric": "P-01", "weight": 0.25, "sense": "keep_in_range" },
        { "metric": "P-02", "weight": 0.20, "sense": "minimize" },
        { "metric": "P-11", "weight": 0.15, "sense": "minimize_excess" },
        { "metric": "P-03", "weight": 0.15, "sense": "keep_in_range" },
        { "metric": "P-09", "weight": 0.10, "sense": "keep_order" },
        { "metric": "P-12", "weight": 0.10, "sense": "preserve" },
        { "metric": "P-19", "weight": 0.05, "sense": "minimize" }
      ],
      "constraints_emphasis": ["S-01", "S-02", "S-03", "S-04"]
    },
    {
      "id": "bass_heavy", "spec_id": "OF-1", "kind": "score",
      "label": { "ja": "重低音強化", "en": "Bass heavy" },
