      "constraints_emphasis": ["S-03", "S-04"],
      "report_notes": ["normalization_tradeoff"]
    },
    {
      "id": "vocal_forward", "spec_id": "OF-2", "kind": "score",
      "label": { "ja": "ボーカル前面", "en": "Vocal forward" },
