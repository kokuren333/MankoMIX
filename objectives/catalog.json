        { "metric": "P-03", "variant": "lra_density", "weight": 0.25, "sense": "keep_in_range" },
        { "metric": "P-17", "weight": 0.15, "sense": "minimize_excess" },
        { "metric": "P-16", "weight": 0.15, "sense": "minimize" },
