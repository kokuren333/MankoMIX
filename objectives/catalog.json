      "summary": { "ja": "主役の輪郭と、歌詞・音価の聞き取りやすさ" },
      "terms": [
        { "metric": "P-02", "weight": 0.30, "sense": "minimize" },
        { "metric": "P-11", "variant": "two_sided", "weight": 0.20, "sense": "keep_in_range" },
        { "metric": "P-12", "weight": 0.20, "sense": "preserve" },
        { "metric": "P-15", "weight": 0.15, "sense": "keep_in_range" },
