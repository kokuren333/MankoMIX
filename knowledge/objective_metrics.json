      "default": { "range_hz": [20.0, 250.0], "base": [-4.0, 6.0], "limit": [2.0, 9.0], "scale": 3.0, "unit": "dB low/rest", "evidence": "practice" },
      "sub": { "range_hz": [20.0, 60.0], "base": [-14.0, 0.0], "limit": [-8.0, 2.0], "scale": 3.0, "unit": "dB band/rest", "evidence": "practice" },
      "bass": { "range_hz": [60.0, 250.0], "base": [-6.0, 4.0], "limit": [-2.0, 6.0], "scale": 3.0, "unit": "dB band/rest", "evidence": "practice" },
