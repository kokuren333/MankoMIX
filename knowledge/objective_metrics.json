{
  "schema_version": 1,
  "status": "draft",
  "note": "Target ranges, penalty scales and intensity limits used by core/objectives.py to turn proxy metrics (docs/SPEC.md 4.2) into objective terms (4.1, 4.4, 4.7). Every value is an initial [model]/[practice] value subject to calibration (4.9). Penalty shape everywhere: 0 inside [lo, hi] (null = open bound), 1 - exp(-(d/scale)^2) outside (core/analysis/perceptual.py range_penalty). 'base' is the comfort-equivalent target (intensity 0); 'limit' is the target an objective reaches at intensity 1 (the objective's limit, 4.7). Terms of 'comfort' never move with intensity. Where references exist their measured distribution replaces 'base' (R-17, R-33). Safety invariants (S-nn) are NOT defined here and are never relaxed by anything in this file.",
  "intensity": {
    "exempt_objectives": ["comfort"],
    "note": "target = base + intensity * (limit - base), bound by bound. Terms without a limit do not move."
  },
  "genre": {
    "emphasis_factor": 1.5,
    "evidence": "practice",
    "note": "Terms named in a genre prior's 'emphasis' list get their initial weight multiplied by this factor; the objective's term weights are then renormalised to 1. Only initial weights and target ranges are affected (R-33); constraints never."
  },
  "reference": {
    "single_reference_iqr_db_mid": 6.0,
    "single_reference_iqr_db_edge": 10.0,
    "min_iqr_db": 3.0,
    "scalar_min_half_width": { "P-07:sub+bass": 1.5, "P-07:playable_band": 1.5, "P-03:plr": 1.5, "P-03:psr": 1.5, "P-03:lra": 1.5, "P-05:width_restraint": 0.05, "P-11": 1.0 },
    "evidence": "practice",
    "note": "P-01 reference distribution from user references (4.6): per ERB band median and IQR of the level-matched LTAS. With one reference the IQR is a default width (mid range / edges, same ERB interpolation as the generic prior); with more the measured IQR is floored at min_iqr_db. Scalar targets from references use median +/- max(IQR/2, scalar_min_half_width)."
  },
  "metrics": {
    "P-01": { "default": { "mode": "module", "unit": "penalty", "evidence": "model" } },
    "P-02": {
      "overall": { "from": "masking_model:penalties.overall", "limit": [0.0, 1.5], "unit": "dB buried" },
      "vs_lead": { "from": "masking_model:penalties.vs_lead", "limit": [0.0, 1.0], "unit": "dB buried" },
      "low_to_mid": { "from": "masking_model:penalties.low_to_mid", "limit": [0.0, 1.0], "unit": "dB buried" },
      "time_axis": { "from": "masking_model:penalties.time_axis", "limit": [0.0, 1.5], "unit": "dB buried" }
    },
    "P-03": {
      "default": { "plr_db": [7.0, 18.0], "lra_lu": [2.0, 15.0], "scale": 3.0, "unit": "dB / LU", "evidence": "practice" },
      "plr": { "base": [7.0, 18.0], "scale": 3.0, "unit": "dB", "evidence": "practice" },
      "psr": { "base": [6.0, 14.0], "limit": [8.0, 14.0], "scale": 2.5, "unit": "dB", "evidence": "practice" },
      "lra": { "base": [2.0, 15.0], "scale": 3.0, "unit": "LU", "evidence": "practice" },
      "lra_density": { "base": [3.0, 12.0], "density_p95_p10_lu": [3.0, null], "scale": 3.0, "unit": "LU", "evidence": "practice" }
    },
    "P-04": {
      "kick_band": { "bands": ["sub", "bass"], "loss_ok_db": 1.5, "scale": 4.5, "unit": "dB crest loss", "evidence": "model" },
      "default": { "bands": ["sub", "bass", "lowmid", "mid", "highmid", "air"], "loss_ok_db": 1.5, "scale": 4.5, "unit": "dB crest loss", "evidence": "model" }
    },
    "P-05": {
      "width_restraint": { "base": [0.0, 0.3], "limit": [0.0, 0.2], "scale": 0.1, "unit": "side ratio", "evidence": "practice" },
      "default": { "base": [0.0, 0.4], "scale": 0.1, "unit": "side ratio", "evidence": "practice" }
    },
