    },
    "P-08": { "default": { "from": "masking_model:p08", "limit": [-8.0, null], "unit": "dB harmonic index" } },
    "P-09": { "default": { "mode": "module", "unit": "penalty", "evidence": "model" } },
    "P-10": { "default": { "from": "masking_model:p10", "limit_shift_db": 3.0, "unit": "dB lead - accompaniment" } },
