      "default": { "from": "thresholds_m3:p11_harshness", "limit": [null, 1.0], "unit": "dB prominence" },
      "two_sided": { "from": "thresholds_m3:p11_harshness.presence", "unit": "dB prominence" }
    },
    "P-12": { "default": { "mode": "module", "unit": "penalty", "evidence": "model" } },
    "P-13": { "default": { "mode": "module", "unit": "penalty (beating risk)", "evidence": "standard/practice" } },
    "P-14": { "default": { "scale": 1.0, "unit": "dBTP", "evidence": "standard" } },
    "P-15": {
      "default": { "from": "masking_model:p15", "unit": "dB D/R" },
      "lead": { "from": "masking_model:p15", "limit": [6.0, null], "unit": "dB D/R" }
    },
    "P-16": { "default": { "mode": "external", "source": "cleanup", "unit": "penalty" } },
    "P-17": { "default": { "from": "thresholds_m3:p17_sibilance", "limit": [null, 5.0], "unit": "dB p99 prominence" } },
    "P-18": { "default": { "from": "thresholds:p18_limiter_dependency", "scale": 2.0, "unit": "dB GR p95" } },
    "P-19": { "default": { "mode": "module", "unit": "penalty", "evidence": "model" } },
    "P-20": { "default": { "mode": "module", "needs_before": true, "unit": "dB contrast shrink", "evidence": "model" } },
    "P-21": { "default": { "mode": "external", "source": "cleanup", "unit": "penalty" } },
    "P-22": { "default": { "mode": "module", "unit": "penalty", "evidence": "practice" } }
  },
  "variant_aliases": { "P-02": { "temporal": "time_axis", "default": "overall" }, "P-07": { "default": "sub+bass" } },
  "gate": {
    "small_speaker": { "highpass_hz": 150.0, "lowpass_hz": 8000.0, "order": 4, "lead_drop_tolerance_db": 3.0, "lead_retained_min_db": -9.0, "evidence": "practice" },
    "mono_fold": { "any_band_max_db": 6.0, "strict_low_band_max_db": 0.5, "lead_stem_clarity_max_db": 1.0, "evidence": "practice" },
    "low_level": { "phon_low": 60.0, "phon_reference": 80.0, "tolerance_db": 3.0, "evidence": "model" },
    "pitch": { "mix_lowpass_hz": 400.0, "evidence": "model" },
    "note": "OF-5 translation gate (4.5). Thresholds for mono fold reuse knowledge/thresholds.json S-04 values; these are the extra gate values. Small-speaker and fundamental-removed checks follow playback_assumptions.small_speaker_check; strict mono fold follows mono_fold_strict."
  },
  "planner": {
    "eq_step_db": 0.5,
    "max_candidates_per_iteration": 6,
    "excerpt_s": 4.0,
    "excerpt_fade_s": 0.05,
    "full_length_below_s": 14.0,
    "eq_bands": [
      { "id": "sub", "shape": "low_shelf", "freq_hz": 60.0, "bw_oct": 1.9 },
      { "id": "bass", "shape": "peak", "freq_hz": 120.0, "bw_oct": 1.5 },
      { "id": "low_mid", "shape": "peak", "freq_hz": 350.0, "bw_oct": 1.5 },
      { "id": "mid", "shape": "peak", "freq_hz": 1000.0, "bw_oct": 1.5 },
      { "id": "high_mid", "shape": "peak", "freq_hz": 3500.0, "bw_oct": 1.5 },
      { "id": "air", "shape": "high_shelf", "freq_hz": 8000.0, "bw_oct": 1.9 }
    ],
    "safety_valves": {
      "low_end_min_db": -4.0,
      "presence_min_db": -4.0,
      "note": "R-29: a move that cuts low end may not push P-07 low/rest below low_end_min_db (unless it already was); a move that cuts presence may not push the P-11 presence value below presence_min_db."
    },
    "evidence": "practice",
    "note": "Deterministic planner (SPEC 7.2). EQ moves are small (R-06) and the cumulative master EQ stays within knowledge/thresholds.json master_eq.max_abs_gain_db (R-15)."
  }
