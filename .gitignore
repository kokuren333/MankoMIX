# --- 絶対にコミットしないもの（衛生ルール / docs/SPEC.md §16） ---
/_handoff/
/_private/
# ローカル起動用スクリプト（環境依存の内容を含みうる）
/run_*.bat
/run_*.sh
/serve_*.bat
/serve_*.sh
*.local.*
.env
.env.*

# --- 音声・モデル等の大容量バイナリ（リポジトリには置かない。docs/SPEC.md §15） ---
*.wav
*.aiff
*.aif
*.flac
*.mp3
*.m4a
*.aac
*.ogg
*.opus
*.ckpt
*.pth
*.pt
*.onnx
*.safetensors
# 例外: 公式サンプルの試聴用 MP3（samples/public/audio/）。オーナー承認済み（D-061）。SPEC §15.4 の「samples/public/ だけを例外にする」
!samples/public/audio/*.mp3

# --- プロジェクト作業生成物 ---
*.mmx/cache/
*.mmx/renders/
/out/
/tmp/
/models/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# --- Node / GUI ---
node_modules/
/gui/dist/
.vite/

# --- ネイティブビルド ---
/dsp/build/
CMakeCache.txt
CMakeFiles/
*.obj
*.o
*.dll
*.so
*.dylib
*.exe

# --- OS / エディタ ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# --- 蓄積 kb はローカル資産（D-068 / docs/RESEARCH_PROTOCOL.md §5） ---
# 蓄積の既定の置き場は _private/kb/（上の /_private/ で除外済み）。
# 公開 kb（kb/）には既定のカードだけを置くため、新規の蓄積物はここでも止める。
# 既に追跡されているファイルには効かない。昇格（公開への移行）は git add -f で明示する。
/kb/songs/*/
/kb/songs/*/*/
/kb/lessons/*.md
/kb/moves/*.md
/kb/theory/*.md
/kb/research/
/kb/curricula/*.md
/kb/references/
